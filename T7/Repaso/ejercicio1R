-- 1. Tablas independientes (sin FKs o padres de herencia)
create table usuario (
    codUsuario       serial,
    email            varchar(150) not null, 
    password         varchar(20) not null, -- He ampliado a 20 para mayor seguridad
    fechaAlta        date not null,
    nombre           varchar(100) not null,
    constraint pk_usuario primary key(codUsuario)
); 

create table revisable (
    id_revisable    serial,
    constraint pk_revisable primary key (id_revisable)
); 

create table compania(
    idCompania       serial,
    nombre           varchar(150) not null,
    constraint pk_compania primary key (idCompania)
);

create table empleado (
    numSegSocial     serial,
    nombre           varchar(150) not null,
    direccion        varchar(300) not null,
    sueldo           numeric(9,2) not null,
    constraint pk_empleado primary key (numSegSocial)
);

-- 2. Tablas que heredan o dependen de las anteriores
-- IMPORTANTE: Aquí las FK deben ser INT, no SERIAL
create table revision (
    codUsuario      int,         -- Cambiado serial -> int (es FK)
    id_revisable    int,         -- Cambiado serial -> int (es FK)
    fecha           timestamp not null,
    comentario      varchar(300),
    constraint pk_revision primary key (codUsuario, id_revisable)
);

create table serie (
    codSerie        serial,
    nombre          varchar(150) not null,
    numTemporada    int not null,
    id_revisable    int,         -- Cambiado serial -> int (es FK)
    idCompania      int,         -- Cambiado serial -> int (es FK)
    constraint pk_serie     primary key (codSerie),
    constraint uq_serie_revisable unique (id_revisable) -- Para mantener el 1:1 de la herencia
); 

create table episodio (
    numEpisodio     serial,
    titulo          varchar(100) not null, -- Ampliado (15 era muy poco para un título)
    codSerie        int,         -- Cambiado serial -> int (es FK)
    id_revisable    int,         -- Corregido typo 'id_revisanle' y cambiado a int
    constraint pk_episodio primary key (numEpisodio)
); 

create table emision (
    numEpisodio     int,         -- Cambiado serial -> int (es FK y hereda identidad)
    fecha           date,
    constraint pk_emision primary key (numEpisodio)
); 

-- Tablas de Herencia (Especialización)
create table actor (
    numSegSocial    int,         -- Cambiado serial -> int (es FK de empleado)
    constraint pk_actor primary key (numSegSocial)
); 

create table director (
    numSegSocial    int,         -- Cambiado serial -> int (es FK de empleado)
    constraint pk_director primary key (numSegSocial)
); 

-- Tablas de relación N:M
create table actua (
    numSegSocial    int,
    codSerie        int,
    constraint pk_actua primary key (numSegSocial, codSerie)
); 

create table trabaja (
    fechaInicio     date,
    idCompania      int,
    numSegSocial    int,
    fechaFin        date,
    constraint pk_trabaja primary key (fechaInicio, idCompania, numSegSocial)
);

-- 3. Definición de todas las Foreign Keys (ALTER TABLE)
alter table revision 
    add constraint fk_revision_usuario foreign key (codUsuario) references usuario(codUsuario),
    add constraint fk_revision_revisable foreign key (id_revisable) references revisable(id_revisable);

alter table serie
    add constraint fk_serie_revisable foreign key (id_revisable) references revisable(id_revisable),
    add constraint fk_serie_compania foreign key  (idCompania) references compania(idCompania);

alter table trabaja
    add constraint fk_trabaja_compania foreign key (idCompania) references compania(idCompania),
    add constraint fk_trabaja_empleado foreign key (numSegSocial) references empleado(numSegSocial);

alter table actua
    add constraint fk_actua_actor foreign key (numSegSocial) references actor(numSegSocial),
    add constraint fk_actua_serie foreign key (codSerie) references serie(codSerie);

alter table episodio
    add constraint fk_episodio_serie foreign key (codSerie) references serie(codSerie),
    add constraint fk_episodio_revisable foreign key (id_revisable) references revisable(id_revisable);

alter table emision 
    add constraint fk_emision_episodio foreign key (numEpisodio) references episodio(numEpisodio);

-- Faltaban las FK de la herencia de empleados:
alter table actor 
    add constraint fk_actor_empleado foreign key (numSegSocial) references empleado(numSegSocial);

alter table director 
    add constraint fk_director_empleado foreign key (numSegSocial) references empleado(numSegSocial);